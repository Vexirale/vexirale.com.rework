{
  "compilerOptions": {
    "target": "ES2021",
    // DOM is here for the page.evaluate() callbacks in handlers/browser.ts —
    // those are serialized and run inside the headless browser, where window
    // and document exist. Worker code itself must not rely on DOM globals.
    "lib": ["ES2021", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"]
}
